# CampusFix backend environment variables
# Copy this file to backend/.env and fill in real values:
#   cp .env.example backend/.env

# Server
NODE_ENV=development
PORT=5000

# Origin of the React app (used for cookie/socket configuration)
CLIENT_URL=http://localhost:5173

# MongoDB - local instance or MongoDB Atlas connection string
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusfix
MONGODB_URI=mongodb://127.0.0.1:27017/campusfix

# JWT secrets - use long random strings, different for each token type.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor
BCRYPT_SALT_ROUNDS=10

# Complaints not resolved within this many hours are flagged as overdue
OVERDUE_AFTER_HOURS=72
